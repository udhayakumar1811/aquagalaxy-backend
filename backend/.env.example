# --- Core (required now) ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/AquaShop
JWT_SECRET=replace_with_a_long_random_string

# --- Cloudinary (required now — product/category/banner/gallery images + payment screenshots) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend/backend URLs (used for CORS allow-list — see server.js) ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Comma-separated list of exact origins allowed to call this API.
# REQUIRED in production — without it, only localhost dev origins are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# --- Razorpay (code is wired up — set these to go live with card/UPI/netbanking payments) ---
# --- Razorpay (code is wired up — set these to go live with card/UPI/netbanking payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook reliability backstop (Priority 2) — set this to the SAME value you
# configure in Razorpay Dashboard > Settings > Webhooks when creating the
# webhook. URL: https://<your-backend-domain>/api/payments/razorpay/webhook
# Active events to enable: payment.captured (required)
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (code is wired up — set these to send real
# order-alert and status-update messages instead of just logging them) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email / SMTP (code is wired up — set these to send real welcome/order/
# shipping emails instead of just logging them) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# --- Professional Courier (abstraction + mock mode is wired up; ask Professional
# Courier for their official API base URL, auth method and field names before
# filling these in — do NOT invent values here, and see utils/courierService.js) ---
PROFESSIONAL_COURIER_API_BASE_URL=
PROFESSIONAL_COURIER_API_KEY=
PROFESSIONAL_COURIER_ACCOUNT_ID=
